{
	"name": "@cellix/config-vitest",
	"version": "1.0.0",
	"type": "module",
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"types": "dist/index.d.ts",
	"scripts": {
		"build": "tsc --build",
		"test": "vitest run --silent --reporter=dot",
		"test:coverage": "vitest run --coverage --silent --reporter=dot",
		"test:watch": "vitest",
		"typecheck": "tsc --noEmit --pretty false -p tsconfig.json"
	},
	"dependencies": {
		"@cellix/config-typescript": "workspace:*",
		"@storybook/addon-vitest": "catalog:",
		"@vitest/browser-playwright": "catalog:",
		"typescript": "catalog:",
		"vitest": "catalog:"
	},
	"devDependencies": {
		"@types/node": "catalog:"
	}
}
