{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"jsx": "react-jsx",
		"strict": true,
		"skipLibCheck": true,
		"noEmit": true,
		"esModuleInterop": true,
		"allowSyntheticDefaultImports": true,
		"verbatimModuleSyntax": false,
		"types": ["node"],
		"lib": ["ES2023", "DOM"]
	},
	"include": ["src/**/*.ts", "docusaurus.config.ts", "sidebars.ts"]
}
